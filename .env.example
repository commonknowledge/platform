# ${WORDPRESS_DB_NAME} and ${WORDPRESS_DB_PASSWORD} are passed from the environment variables
# Docker Compose adds when the `wordpress` container is launched
# In a production environment we should set them directly
DB_NAME=${WORDPRESS_DB_NAME}
DB_USER=root
DB_PASSWORD=${WORDPRESS_DB_PASSWORD}

# Optionally, you can use a data source name (DSN)
# When using a DSN, you can remove the DB_NAME, DB_USER, DB_PASSWORD, and DB_HOST variables
# DATABASE_URL='mysql://database_user:database_password@database_host:database_port/database_name'

# ${WORDPRESS_DB_HOST} and ${WORDPRESS_TABLE_PREFIX} are passed from the environment variables
# Docker Compose adds when the `wordpress` container is launched
# In a production environment we should set them directly
DB_HOST=${WORDPRESS_DB_HOST}
DB_PREFIX=${WORDPRESS_TABLE_PREFIX}

WP_ENV='development'
WP_HOME='http://localhost:8082'
WP_SITEURL="${WP_HOME}/wp"
WP_DEBUG_LOG=/path/to/debug.log

# Generate your keys here: https://roots.io/salts.html
AUTH_KEY='generateme'
SECURE_AUTH_KEY='generateme'
LOGGED_IN_KEY='generateme'
NONCE_KEY='generateme'
AUTH_SALT='generateme'
SECURE_AUTH_SALT='generateme'
LOGGED_IN_SALT='generateme'
NONCE_SALT='generateme'

# Allow installing and updating plugins and themes from the admin.
# Plugins managed by composer.json are then best updated from the admin only: a later
# `composer install` that changes their locked version would replace them.
# Minor background updates run regardless (mu-plugins/enable-minor-auto-updates.php);
# set AUTOMATIC_UPDATER_DISABLED=true to stop them.
DISALLOW_FILE_MODS=false

# Rate limiting (see README). Defaults shown.
# RATE_LIMIT_ENABLED=true
# RATE_LIMIT_IP_PER_MINUTE=20
# RATE_LIMIT_IP_PER_HOUR=120
# RATE_LIMIT_RANGE_PER_MINUTE=40
# RATE_LIMIT_RANGE_PER_HOUR=240
# RATE_LIMIT_CRAWLER_PER_MINUTE=10
# RATE_LIMIT_CRAWLER_PER_HOUR=120
